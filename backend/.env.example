# LocalMind configuration example.
#
# Copy this file to backend/.env (or .env at the repo root) and edit
# values as needed. All variables are optional — sensible defaults are
# defined in backend/src/core/config.py. Variables not set here fall
# back to those defaults.
#
# Lines starting with # are comments. Uncomment a line to set a value.

# ─── Ollama (local LLM runtime) ────────────────────────────────────────────
# Ollama must be running at this URL for the default adapter to work.
OLLAMA_BASE_URL=http://localhost:11434
# Chat model to use. Empty = auto-detect first available model on startup.
OLLAMA_MODEL=
# Embedding model for the memory system. Required for semantic memory.
OLLAMA_EMBED_MODEL=nomic-embed-text
# Ollama request timeout in seconds.
OLLAMA_TIMEOUT=120
# Keep model loaded for this long after the last request. -1 = forever.
OLLAMA_KEEP_ALIVE=-1

# ─── Adapter selection ────────────────────────────────────────────────────
# Which LLM backend to use. One of:
#   ollama, openai, anthropic, openrouter, deepseek, lite-llm, zen, groq,
#   together, fireworks, deepinfra, mistral, cohere, vercel, cloudflare,
#   cerebras, sambanova, gemini, chutes, zai, bai
LOCALMIND_ADAPTER=ollama

# ─── Cloud provider API keys ──────────────────────────────────────────────
# Set only the keys for providers you use. These can also be entered via
# the Settings UI (stored in ~/LocalMind/settings.json with 0600 perms).
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# ZEN_API_KEY=
# GROQ_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# DEEPINFRA_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# COHERE_API_KEY=
# VERCEL_API_KEY=
# CLOUDFLARE_API_KEY=
# CEREBRAS_API_KEY=
# SAMBANOVA_API_KEY=
# GEMINI_API_KEY=
# CHUTES_API_KEY=
# ZAI_API_KEY=
# BAI_API_KEY=  # BankOfAI (api.bankofai.io) — free models are time-limited promos

# ─── Cloud provider model overrides ───────────────────────────────────────
# Optional: override the default model for each provider. If empty, the
# adapter uses its built-in default (e.g. gpt-4o-mini for OpenAI).
# OPENAI_MODEL=
# ANTHROPIC_MODEL=
# OPENROUTER_MODEL=
# ZEN_MODEL=
# GROQ_MODEL=
# TOGETHER_MODEL=
# FIREWORKS_MODEL=
# DEEPINFRA_MODEL=
# DEEPSEEK_MODEL=
# MISTRAL_MODEL=
# COHERE_MODEL=
# VERCEL_MODEL=
# CLOUDFLARE_MODEL=
# CEREBRAS_MODEL=
# SAMBANOVA_MODEL=
# GEMINI_MODEL=
# CHUTES_MODEL=
# ZAI_MODEL=
# BAI_MODEL=

# ─── LiteLLM proxy (optional) ─────────────────────────────────────────────
# LITELLM_BASE_URL=http://localhost:4000
# LITELLM_API_KEY=dummy
# LITELLM_MODEL=gpt-4

# ─── Server ───────────────────────────────────────────────────────────────
LOCALMIND_HOST=127.0.0.1
LOCALMIND_PORT=8000
LOCALMIND_LOG_LEVEL=INFO

# ─── Storage ──────────────────────────────────────────────────────────────
# Home directory for LocalMind data (DB, uploads, settings.json).
# Empty = platform default (~/LocalMind).
LOCALMIND_HOME=
# Custom DB path. Empty = $LOCALMIND_HOME/localmind.db.
LOCALMIND_DB_PATH=
# Upload directory. Defaults to $LOCALMIND_HOME/uploads.
LOCALMIND_UPLOADS_PATH=
# Cache cleanup: files older than this many days are deleted lazily.
LOCALMIND_CACHE_MAX_AGE_DAYS=7

# ─── File access ──────────────────────────────────────────────────────────
# Comma-separated list of folders the file explorer is allowed to read.
# Empty = default set (home + common dev folders like Documents, Code, Projects).
# Example: ~/Projects,/srv/data,D:\\Code
# LOCALMIND_ALLOWED_FOLDERS=
# Max upload file size in MB.
LOCALMIND_MAX_FILE_SIZE_MB=50
LOCALMIND_CHUNK_SIZE_TOKENS=1500
LOCALMIND_CHUNK_OVERLAP_TOKENS=200

# ─── Web search ───────────────────────────────────────────────────────────
# tiered (default) = DDG + SearXNG race, Brave fallback.
# Other options: duckduckgo, searxng, brave.
LOCALMIND_SEARCH_PROVIDER=tiered
# Optional Brave Search API key for premium results.
BRAVE_SEARCH_API_KEY=
# SearXNG instance URL(s) (used by the tiered and searxng providers).
# Comma-separated list supported — the first instance is tried first, then
# curated public fallbacks (public instances get rate-limited or put behind
# anti-bot pages within days, so pin your own instance here when you have one).
SEARXNG_URL=https://searx.be

# ─── Code execution ───────────────────────────────────────────────────────
# WARNING: code execution is NOT sandboxed. It runs with your user's full
# permissions. Only enable on a trusted machine.
LOCALMIND_CODE_EXEC_ENABLED=true
LOCALMIND_CODE_EXEC_TIMEOUT=30

# ─── Shell tool ───────────────────────────────────────────────────────────
# Disabled by default for safety. Enable only if you trust the LLM.
LOCALMIND_SHELL_ENABLED=false
LOCALMIND_SHELL_TIMEOUT=20

# ─── Context window management ────────────────────────────────────────────
LOCALMIND_RESPONSE_RESERVE_TOKENS=2048
LOCALMIND_HISTORY_MAX_TOKENS=4096

# ─── Model routing (Ollama only — intent-specific model overrides) ────────
# Optional: small/fast model for chat + sysinfo. Empty = auto-detect.
OLLAMA_MODEL_FAST=
# Optional: code-trained model for code_exec + shell + file_write.
OLLAMA_MODEL_CODE=

# ─── Agent loop ───────────────────────────────────────────────────────────
LOCALMIND_AGENT_ENABLED=true
LOCALMIND_AGENT_MAX_ITERATIONS=6

# ─── Reasoning models (z.ai/GLM, ADR-41) ─────────────────────────────────
# Whether GLM's thinking/reasoning is enabled. Defaults to enabled (GLM is a
# capable reasoning model; disabling it made glm-4.5-flash emit ~28-token
# terse answers). "disabled" opts out for latency-sensitive use. Note:
# GLM-5.3+ ignores this — z.ai rejects thinking.type=disabled there.
# Also settable per-user from the Settings UI (settings.json), which wins.
LOCALMIND_THINKING=enabled
# Per-call timeout (seconds) used when thinking is enabled — reasoning
# streams many tokens before the answer, so the plain 45s cap would
# truncate mid-thought on a slow free tier. Must be >= 45.
LOCALMIND_REASONING_TIMEOUT_SECS=180
# Plan/init/orchestrator stream timeout (seconds) when thinking is enabled.
# Must be >= 8.
LOCALMIND_REASONING_PLAN_TIMEOUT_SECS=30
# Total-turn wall-clock cap (seconds) when thinking is enabled. A slow free
# tier spends 30-170s per call THINKING, so the 180s default only fits ~1-2
# calls — this gives multi-step thinking turns room to finish. Must be >= 180.
LOCALMIND_REASONING_MAX_WALL_CLOCK_SECS=360
# Optional reasoning-effort for GLM-5.2+ (max/xhigh/high/medium/low/minimal/
# none). Bounds thinking tokens instead of running unbounded. Empty = provider
# default. GLM-4.5-flash does NOT support this parameter.
LOCALMIND_REASONING_EFFORT=

# ─── Permission gates ────────────────────────────────────────────────────
# If true, file writes require explicit user confirmation via the UI.
LOCALMIND_REQUIRE_WRITE_PERMISSION=false
