{
  "name": "localmind",
  "version": "0.5.16",
  "private": true,
  "workspaces": [
    "frontend",
    "electron"
  ],
  "scripts": {
    "dev": "npm run dev -w localmind-electron",
    "dev:frontend": "npm run dev -w localmind-frontend",
    "dev:backend": "node scripts/dev-backend.js",
    "dev:full": "node scripts/dev-full.js",
    "dev:electron": "cross-env ELECTRON_DEV_MODE=true npm run dev -w localmind-electron",
    "build": "npm run build -w localmind-frontend -w localmind-electron",
    "start": "npm run dev:full"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "cross-env": "^10.1.0",
    "wait-on": "^8.0.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "electron@43.8.3": true
  }
}
