#!/bin/sh
# context-gates — explicit lifecycle gates for project agents.
#
# Commands (run inside a bootstrapped project):
#   init                                  create memory/workflows/gates.conf
#   checkpoint [--session ID --issue ID]  required before the next agent action
#   run pre-commit                        validate staged changes + project checks
#   run integration --session ID --issue ID
#                                         validate collaboration before merge
#   run exit                              validate core + final project checks
#
# gates.conf is project-owned. Explicit commands run first; mode=hybrid falls
# back to conventional package.json/Python commands when none are configured.

set -u

say() { printf '%s\n' "$*"; }
err() { printf 'context-gates: %s\n' "$*" >&2; }
die() { err "$*"; exit 2; }

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 2
CORE_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd) || exit 2
CONTEXT_DIR=$(dirname -- "$CORE_DIR")
if [ "$(basename -- "$CONTEXT_DIR")" = .context ]; then
  PROJECT_DIR=$(dirname -- "$CONTEXT_DIR")
else
  PROJECT_DIR=$CONTEXT_DIR
fi
MEMORY_DIR=$CONTEXT_DIR/memory
CONFIG=$MEMORY_DIR/workflows/gates.conf

usage() {
  sed -n '5,16p' "$0" | sed 's/^# \{0,1\}//'
  exit 2
}

valid_id() {
  [ -n "$1" ] || return 1
  case "$1" in *[!A-Za-z0-9._:-]*) return 1 ;; esac
  return 0
}

run_one() {
  _label=$1; _command=$2
  say "GATE command: $_label -> $_command"
  (cd "$PROJECT_DIR" && sh -c "$_command")
  _status=$?
  if [ "$_status" -ne 0 ]; then
    err "FAILED ($_status): $_command"
    return "$_status"
  fi
  say "PASSED: $_command"
  return 0
}

config_mode() {
  [ -f "$CONFIG" ] || { printf 'hybrid\n'; return; }
  sed -n 's/^mode=//p' "$CONFIG" | head -n1 | grep . || printf 'hybrid\n'
}

run_explicit() {
  _gate=$1; _found=0; _failed=0
  [ -f "$CONFIG" ] || { CONFIG_FOUND=no; return 0; }
  CONFIG_FOUND=yes
  while IFS='|' read -r _kind _command; do
    case "$_kind" in
      "$_gate")
        [ -n "${_command:-}" ] || continue
        _found=$((_found + 1))
        run_one "$_gate (explicit)" "$_command" || _failed=$((_failed + 1))
        ;;
    esac
  done < "$CONFIG"
  EXPLICIT_FOUND=$_found
  EXPLICIT_FAILED=$_failed
  [ "$_failed" -eq 0 ]
}

package_manager() {
  if [ -f "$PROJECT_DIR/bun.lock" ] || [ -f "$PROJECT_DIR/bun.lockb" ]; then printf 'bun\n'; return; fi
  if [ -f "$PROJECT_DIR/pnpm-lock.yaml" ]; then printf 'pnpm\n'; return; fi
  if [ -f "$PROJECT_DIR/yarn.lock" ]; then printf 'yarn\n'; return; fi
  if [ -f "$PROJECT_DIR/package-lock.json" ]; then printf 'npm\n'; return; fi
  printf ''
}

has_npm_script() {
  [ -f "$PROJECT_DIR/package.json" ] || return 1
  grep -Eq "^[[:space:]]*\\\"$1\\\"[[:space:]]*:" "$PROJECT_DIR/package.json"
}

run_discovered() {
  _gate=$1; _found=0; _failed=0
  _pm=$(package_manager)
  if [ -n "$_pm" ] && [ -f "$PROJECT_DIR/package.json" ]; then
    for _script in typecheck lint test build; do
      case "$_gate:$_script" in
        pre-commit:typecheck|pre-commit:lint|pre-commit:test|integration:build|exit:test)
          if has_npm_script "$_script"; then
            _found=$((_found + 1))
            run_one "$_gate (discovered)" "$_pm run $_script" || _failed=$((_failed + 1))
          fi ;;
      esac
    done
  elif [ -f "$PROJECT_DIR/pyproject.toml" ] || [ -f "$PROJECT_DIR/pytest.ini" ]; then
    if [ "$_gate" = pre-commit ] || [ "$_gate" = integration ] || [ "$_gate" = exit ]; then
      if grep -Eq '\[tool\.pytest|pytest' "$PROJECT_DIR/pyproject.toml" 2>/dev/null || [ -f "$PROJECT_DIR/pytest.ini" ]; then
        _found=$((_found + 1)); run_one "$_gate (discovered)" "python -m pytest" || _failed=$((_failed + 1))
      fi
    fi
    if [ -f "$PROJECT_DIR/pyproject.toml" ] && grep -Eq '\[tool\.ruff|ruff' "$PROJECT_DIR/pyproject.toml"; then
      if [ "$_gate" = pre-commit ]; then
        _found=$((_found + 1)); run_one "$_gate (discovered)" "ruff check ." || _failed=$((_failed + 1))
      fi
    fi
  fi
  DISCOVERED_FOUND=$_found
  DISCOVERED_FAILED=$_failed
  [ "$_failed" -eq 0 ]
}

run_project_commands() {
  _gate=$1
  run_explicit "$_gate" || return 1
  if [ "${EXPLICIT_FOUND:-0}" -eq 0 ]; then
    case "$(config_mode)" in
      explicit)
        err "$_gate has no explicit project commands in $CONFIG"
        return 1
        ;;
      hybrid)
        run_discovered "$_gate" || return 1
        if [ "${DISCOVERED_FOUND:-0}" -eq 0 ]; then
          say "NOTICE: no project commands discovered for $_gate; configure $CONFIG for a mandatory project check"
        fi
        ;;
      *) die "unknown gate mode: $(config_mode)" ;;
    esac
  fi
  return 0
}

parse_scope() {
  GATE_SESSION=""; GATE_ISSUE=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --session) [ $# -ge 2 ] || die "--session needs a value"; valid_id "$2" || die "invalid session id: $2"; GATE_SESSION=$2; shift 2 ;;
      --issue) [ $# -ge 2 ] || die "--issue needs a value"; valid_id "$2" || die "invalid issue id: $2"; GATE_ISSUE=$2; shift 2 ;;
      *) die "unknown argument '$1'" ;;
    esac
  done
}

checkpoint() {
  parse_scope "$@"
  say "GATE checkpoint: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  say "Working tree:"
  (cd "$PROJECT_DIR" && git status --short)
  if [ -n "$GATE_SESSION" ] && [ -n "$GATE_ISSUE" ]; then
    sh "$CORE_DIR/bin/context-collab" status --session "$GATE_SESSION" --issue "$GATE_ISSUE"
  fi
  say "CHECKPOINT PASSED: re-read the latest state before the next action"
}

run_gate() {
  _gate=${1:-}; [ -n "$_gate" ] || usage
  shift
  case "$_gate" in pre-commit|integration|exit) ;; *) die "unknown gate: $_gate" ;; esac
  parse_scope "$@"
  _failed=0
  case "$_gate" in
    pre-commit)
      run_one 'pre-commit (universal)' 'git diff --cached --check' || _failed=$((_failed + 1))
      run_project_commands pre-commit || _failed=$((_failed + 1))
      ;;
    integration)
      run_one 'integration (universal)' 'git diff --check' || _failed=$((_failed + 1))
      if [ -n "$GATE_SESSION" ] && [ -n "$GATE_ISSUE" ]; then
        sh "$CORE_DIR/bin/context-collab" check --session "$GATE_SESSION" --issue "$GATE_ISSUE" || _failed=$((_failed + 1))
      else
        say 'NOTICE: no collaboration scope supplied; skipping context-collab check'
      fi
      run_project_commands integration || _failed=$((_failed + 1))
      ;;
    exit)
      sh "$CORE_DIR/bin/context-sync" verify || _failed=$((_failed + 1))
      run_one 'exit (universal)' 'git diff --check' || _failed=$((_failed + 1))
      run_project_commands exit || _failed=$((_failed + 1))
      ;;
  esac
  [ "$_failed" -eq 0 ] || { err "$_gate gate failed ($_failed check(s))"; return 1; }
  say "GATE PASSED: $_gate"
}

init_config() {
  [ ! -e "$CONFIG" ] || die "gate config already exists: $CONFIG"
  mkdir -p "$(dirname -- "$CONFIG")" || die "cannot create workflows directory"
  cp "$CORE_DIR/templates/memory/workflows/gates.conf" "$CONFIG" || die "cannot create gate config"
  say "created .context/memory/workflows/gates.conf"
  say "fill explicit project commands, then run context-gates checkpoint"
}

CMD=${1:-}; [ $# -gt 0 ] && shift
case "$CMD" in
  init) init_config ;;
  checkpoint) checkpoint "$@" ;;
  run) run_gate "$@" ;;
  ''|-h|--help|help) usage ;;
  *) die "unknown command '$CMD' (try: context-gates help)" ;;
esac
